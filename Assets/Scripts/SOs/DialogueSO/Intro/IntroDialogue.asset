  dialogue:
    dialogueLines:
    - name: Rina
      leftSprite: {fileID: 0}
      rightSprite: {fileID: 0}
      sentence: "Phew... Look at the view. It\u2019s so peaceful up here, isn't it?"
      onLeft: 0
    - name: Rina
      leftSprite: {fileID: 0}
      rightSprite: {fileID: 0}
      sentence: "Can you believe it? Soon, we\u2019ll both be in university."
      onLeft: 0
    - name: Nara
      leftSprite: {fileID: 0}
      rightSprite: {fileID: 0}
      sentence: Yeah...
      onLeft: 0
    - name: Nara
      leftSprite: {fileID: 0}
      rightSprite: {fileID: 0}
      sentence: ...
      onLeft: 0
    - name: Nara
      leftSprite: {fileID: 0}
      rightSprite: {fileID: 0}
      sentence: Rin...
      onLeft: 0
    - name: Rina
      leftSprite: {fileID: 0}
      rightSprite: {fileID: 0}
      sentence: Hmm?
      onLeft: 0
    - name: Nara
      leftSprite: {fileID: 0}
      rightSprite: {fileID: 0}
      sentence: I'm sorry... I don't think we'll be going to the same university.
      onLeft: 0
    - name: Rina
      leftSprite: {fileID: 0}
      rightSprite: {fileID: 0}
      sentence: Wait, why would you say that? You're literally the smartest person
        I know! That's one of the reasons I love having you as my best friend, you
        know?
      onLeft: 0
    - name: Rina
      leftSprite: {fileID: 0}
      rightSprite: {fileID: 0}
      sentence: "You\u2019re always there whenever I need help. But me? I feel like
        I never really help you back... I just give stupid advice that probably doesn't
        even matter."
      onLeft: 0
    - name: Nara
      leftSprite: {fileID: 0}
      rightSprite: {fileID: 0}
      sentence: What do you mean...? Your advice always means a lot to me.
      onLeft: 0
    - name: Nara
      leftSprite: {fileID: 0}
      rightSprite: {fileID: 0}
      sentence: ...
      onLeft: 0
    - name: Nara
      leftSprite: {fileID: 0}
      rightSprite: {fileID: 0}
      sentence: ...
      onLeft: 0
    - name: Rina
      leftSprite: {fileID: 0}
      rightSprite: {fileID: 0}
      sentence: Yeah?
      onLeft: 0
    - name: Nara
      leftSprite: {fileID: 0}
      rightSprite: {fileID: 0}
      sentence: There's... something I really need to tell you
      onLeft: 0
    - name: Phone
      leftSprite: {fileID: 0}
      rightSprite: {fileID: 0}
      sentence: '*Notification*'
      onLeft: 0
    - name: Nara
      leftSprite: {fileID: 0}
      rightSprite: {fileID: 0}
      sentence: ...
      onLeft: 0
    - name: Nara
      leftSprite: {fileID: 0}
      rightSprite: {fileID: 0}
      sentence: ... /background gelap
      onLeft: 0
    - name: Nara
      leftSprite: {fileID: 0}
      rightSprite: {fileID: 0}
      sentence: ...
      onLeft: 0
    - name: Rina
      leftSprite: {fileID: 0}
      rightSprite: {fileID: 0}
      sentence: Nar? Are you okay?
      onLeft: 0
    - name: Rina
      leftSprite: {fileID: 0}
      rightSprite: {fileID: 0}
      sentence: Nar...?
      onLeft: 0
    - name: Rina
      leftSprite: {fileID: 0}
      rightSprite: {fileID: 0}
      sentence: Nara?!
      onLeft: 0
    - name: Rina
      leftSprite: {fileID: 0}
