%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a53ee3976b5135c4e9247ce665451ab3, type: 3}
  m_Name: PuzzleDialogue
  m_EditorClassIdentifier: 
  dialogue:
    dialogueLines:
    - name: Nara
      background: {fileID: 6324472606935993198, guid: 370c9e3a48b48c744aff25b4aefe2580, type: 3}
      sentence: Is this... my heart?
      onLeft: 0
    - name: Nara
      background: {fileID: 6324472606935993198, guid: 370c9e3a48b48c744aff25b4aefe2580, type: 3}
      sentence: But I'm already too late
      onLeft: 0
    - name: Nara
      background: {fileID: 6324472606935993198, guid: 370c9e3a48b48c744aff25b4aefe2580, type: 3}
      sentence: "I\u2019ve hidden behind this mask for so long."
      onLeft: 0
    - name: Nara
      background: {fileID: 6324472606935993198, guid: 370c9e3a48b48c744aff25b4aefe2580, type: 3}
      sentence: "What\u2019s the point of having a heart if I don't even use it to
        feel?"
      onLeft: 0
    - name: Nara
      background: {fileID: 6324472606935993198, guid: 370c9e3a48b48c744aff25b4aefe2580, type: 3}
      sentence: ...
      onLeft: 0
    - name: Parents
      background: {fileID: 6324472606935993198, guid: 370c9e3a48b48c744aff25b4aefe2580, type: 3}
      sentence: Nara, come here, my sweet angel.
      onLeft: 0
    - name: Nara
      background: {fileID: 6324472606935993198, guid: 370c9e3a48b48c744aff25b4aefe2580, type: 3}
      sentence: Wait... is that my parents' voice?
      onLeft: 0
    - name: Parents
      background: {fileID: 6324472606935993198, guid: 370c9e3a48b48c744aff25b4aefe2580, type: 3}
      sentence: Nara, why do you like helping others?
      onLeft: 0
    - name: Parents
      background: {fileID: 6324472606935993198, guid: 370c9e3a48b48c744aff25b4aefe2580, type: 3}
      sentence: Is it because it genuinely brings you joy... or because you feel
        forced to do it?
      onLeft: 0
    - name: Parents
      background: {fileID: 6324472606935993198, guid: 370c9e3a48b48c744aff25b4aefe2580, type: 3}
      sentence: We never wanted you to force your kindness. We just want you to be
        yourself.
      onLeft: 0
    - name: Parents
      background: {fileID: 6324472606935993198, guid: 370c9e3a48b48c744aff25b4aefe2580, type: 3}
      sentence: Success or failure, Nara... we will always love you no matter what.
      onLeft: 0
    - name: Nara
      background: {fileID: 6324472606935993198, guid: 370c9e3a48b48c744aff25b4aefe2580, type: 3}
      sentence: ...
      onLeft: 0
    - name: Rina
      background: {fileID: 6324472606935993198, guid: 370c9e3a48b48c744aff25b4aefe2580, type: 3}
      sentence: NARA!! NARA!! WAKE UP!!
      onLeft: 0
    - name: Rina
      background: {fileID: 6324472606935993198, guid: 370c9e3a48b48c744aff25b4aefe2580, type: 3}
      sentence: Please, don't give up on me!
      onLeft: 0
    - name: Rina
      background: {fileID: 6324472606935993198, guid: 370c9e3a48b48c744aff25b4aefe2580, type: 3}
      sentence: It's okay if you failed this one! There are so many other universities
        out there!
      onLeft: 0
    - name: Rina
      background: {fileID: 6324472606935993198, guid: 370c9e3a48b48c744aff25b4aefe2580, type: 3}
      sentence: There's always another way!
      onLeft: 0
    - name: Nara
      background: {fileID: 6324472606935993198, guid: 370c9e3a48b48c744aff25b4aefe2580, type: 3}
      sentence: ...
      onLeft: 0
    - name: Echo
      background: {fileID: 6324472606935993198, guid: 370c9e3a48b48c744aff25b4aefe2580, type: 3}
      sentence: So, Nara...
      onLeft: 0
    - name: Echo
      background: {fileID: 6324472606935993198, guid: 370c9e3a48b48c744aff25b4aefe2580, type: 3}
      sentence: Now do you understand the meaning of life?
      onLeft: 0
    - name: Nara
      background: {fileID: 6324472606935993198, guid: 370c9e3a48b48c744aff25b4aefe2580, type: 3}
      sentence: ...
      onLeft: 0
    - name: Nara
      background: {fileID: 6324472606935993198, guid: 370c9e3a48b48c744aff25b4aefe2580, type: 3}
      sentence: I think... I finally understand.
      onLeft: 0
    - name: Nara
      background: {fileID: 6324472606935993198, guid: 370c9e3a48b48c744aff25b4aefe2580, type: 3}
      sentence: Thank you
      onLeft: 0
    changeScene: 1
    sceneName: EndingScene
